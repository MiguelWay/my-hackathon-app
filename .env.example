# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# ---- Frontend (Vite) ----
# Base URL the browser uses to reach the API, ending in /api.
#   Local dev (Vite on :5173, API on :3000):  http://localhost:3000/api
#   Production (same origin as the SPA):      /api
# For production builds put this in `.env.production` instead (that file is committed).
VITE_API_BASE_URL=http://localhost:3000/api

# ---- Backend API (server/) ----
API_PORT=3000
# CORS is only needed when the SPA is served from a different origin than the API.
# Same-origin deployments (the default) can leave this unset.
CORS_ORIGIN=http://localhost:5173
# Serve the built SPA from the API process. Defaults to true when NODE_ENV=production.
SERVE_SPA=true

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=package_returns

# Sessions (signed in users) are valid for this many days.
SESSION_TTL_DAYS=30
# Minutes without a request before the session ends (the SPA signs out at the same time).
SESSION_IDLE_MINUTES=30

# Self-signup creates a NEW customer (tenant). Off in production unless you set this to true.
# Leave it unset in production and create customers with the platform super-admin.
ALLOW_SELF_SIGNUP=true

# Rate limiting. The auth limit counts only FAILED attempts per IP.
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
